# Python编译文件
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境（关键！避免上传venv）
venv/
env/
.venv/

# IDE配置文件（根据你的编辑器添加）
.idea/  # PyCharm
.vscode/  # VS Code
*.swp  # Vim
*.swo

# 日志和缓存
*.log
*.cache
*.pkl

# 系统文件
.DS_Store  # Mac
Thumbs.db  # Windows

# Jupyter Notebook 相关
.ipynb_checkpoints/  # 忽略检查点文件夹
*.ipynb_*  # 忽略临时文件.如 .ipynb_bak